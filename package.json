{
  "name": "project-titan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/index.ts",
    "build": "vp pack src/index.ts --platform node --no-fixed-extension",
    "start": "node dist/index.js",
    "check": "vp lint --type-aware --type-check && vp test",
    "test": "vp test",
    "format": "vp fmt src .railway package.json tsconfig.json README.md",
    "format:check": "vp fmt --check src .railway package.json tsconfig.json README.md",
    "deploy:manual": "railway status && railway up --service botchan --environment production --ci",
    "prepare": "vp config"
  },
  "dependencies": {
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "discord-api-types": "^0.38.56"
  },
  "devDependencies": {
    "@railway/cli": "5.68.0",
    "@types/node": "^26.6.5",
    "railway": "^3.16.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "pnpm@12.11.2"
}
